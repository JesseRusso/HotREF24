<Window x:Class="HotPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:HotPort.Properties"
        mc:Ignorable="d"
        Title="HotREF" Height="650"  Width="380" Closing="Window_Closing" ResizeMode="CanMinimize">

    <DockPanel>
        <DockPanel.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        </DockPanel.Background>
        <!-- Settings menu spans both tabs -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Settings" Margin="15,0,0,0" Command="{Binding SettingsCommand}"/>
        </Menu>

        <!-- Worksheet selector spans both tabs -->
        <StackPanel DockPanel.Dock="Top" Margin="20,6,20,4">
            <Button Content="Select Worksheet" Command="{Binding WorksheetCommand}" Height="20" HorizontalAlignment="Stretch" TabIndex="1" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding WorksheetLabel}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl>
            <TabControl.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
            </TabControl.Background>
            <!-- ═══════════════════ ENERGUIDE TAB ═══════════════════ -->
            <TabItem Header="Energuide" DataContext="{Binding Energuide}">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: COD label -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Select COD button -->
                        <RowDefinition Height="10"/>
                        <!-- 2: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: WALLS header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Main Wall -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: No-Clad Wall -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: Tall Wall -->
                        <RowDefinition Height="10"/>
                        <!-- 7: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 8: FLOOR HEADER header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 9: Floor Header -->
                        <RowDefinition Height="10"/>
                        <!-- 10: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 11: CEILINGS header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 12: Standard ceiling -->
                        <RowDefinition Height="Auto"/>
                        <!-- 13: Vault -->
                        <RowDefinition Height="10"/>
                        <!-- 14: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 15: FLOORS header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 16: Exposed -->
                        <RowDefinition Height="Auto"/>
                        <!-- 17: Garage -->
                        <RowDefinition Height="10"/>
                        <!-- 18: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 19: FOUNDATION header -->
                        <RowDefinition Height="Auto"/>
                        <!-- 20: Floors Above -->
                        <RowDefinition Height="Auto"/>
                        <!-- 21: Interior Wall -->
                        <RowDefinition Height="Auto"/>
                        <!-- 22: template label -->
                        <RowDefinition Height="Auto"/>
                        <!-- 23: template button -->
                        <RowDefinition Height="10"/>
                        <!-- 24: spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- 25: Create button -->
                    </Grid.RowDefinitions>

                    <!-- COD file -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CodLabel}" FontStyle="Italic" Margin="0,0,0,2"/>
                    <Button Grid.Row="0" Grid.ColumnSpan="2" Content="Select Code Library" Command="{Binding SelectCodCommand}" Height="20" HorizontalAlignment="Left" Width="160"/>

                    <!-- Walls -->
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="WALLS" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Label Grid.Row="4" Grid.Column="0" Content="Main Walls" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Height="20" ItemsSource="{Binding WallCodes}" Foreground="Blue" SelectedItem="{Binding SelectedMainWallCode}"/>
                    <Label Grid.Row="5" Grid.Column="0" Content="No-Clad Walls" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" Height="20" Margin="0,2,0,0" ItemsSource="{Binding WallCodes}" Foreground="Blue" SelectedItem="{Binding SelectedNoCladWallCode}"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="Tall Walls" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Height="20" Margin="0,2,0,0" ItemsSource="{Binding WallCodes}" Foreground="Blue" SelectedItem="{Binding SelectedTallWallCode}"/>

                    <!-- Floor header -->
                    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="FLOOR HEADER" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Label Grid.Row="9" Grid.Column="0" Content="Floor Headers" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="9" Grid.Column="1" Height="20" ItemsSource="{Binding FloorHeaderCodes}" Foreground="Blue" SelectedItem="{Binding SelectedFloorHeaderCode}"/>

                    <!-- Ceilings -->
                    <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="CEILINGS" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Label Grid.Row="12" Grid.Column="0" Content="Standard" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="12" Grid.Column="1" Height="20" ItemsSource="{Binding CeilingCodes}" Foreground="Blue" SelectedItem="{Binding SelectedCeilingCode}"/>
                    <Label Grid.Row="13" Grid.Column="0" Content="Vault" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="13" Grid.Column="1" Height="20" Margin="0,2,0,0" ItemsSource="{Binding VaultCodes}" Foreground="Blue" SelectedItem="{Binding SelectedVaultCode}"/>

                    <!-- Floors -->
                    <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Text="FLOORS" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Label Grid.Row="16" Grid.Column="0" Content="Exposed" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="16" Grid.Column="1" Height="20" ItemsSource="{Binding ExposedFloorCodes}" Foreground="Blue" SelectedItem="{Binding SelectedExposedFloorCode}"/>
                    <Label Grid.Row="17" Grid.Column="0" Content="Garage" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="17" Grid.Column="1" Height="20" Margin="0,2,0,0" ItemsSource="{Binding GarageFloorCodes}" Foreground="Blue" SelectedItem="{Binding SelectedGarageFloorCode}"/>

                    <!-- Foundation -->
                    <TextBlock Grid.Row="19" Grid.ColumnSpan="2" Text="FOUNDATION" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Label Grid.Row="20" Grid.Column="0" Content="Floors Above" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="20" Grid.Column="1" Height="20" ItemsSource="{Binding FloorsAboveCodes}" Foreground="Blue" SelectedItem="{Binding SelectedFloorsAboveCode}"/>
                    <Label Grid.Row="21" Grid.Column="0" Content="Interior Wall" VerticalAlignment="Center" Padding="0"/>
                    <ComboBox Grid.Row="21" Grid.Column="1" Height="20" Margin="0,2,0,0" ItemsSource="{Binding InteriorWallCodes}" Foreground="Blue" SelectedItem="{Binding SelectedInteriorWallCode}"/>

                    <!-- Template -->
                    <TextBlock Grid.Row="23" Grid.ColumnSpan="2" Text="{Binding TemplateLabel}" FontStyle="Italic" Margin="0,2,0,2"/>
                    <Button Grid.Row="22" Grid.ColumnSpan="2" Content="Select Template" Command="{Binding SelectTemplateCommand}" Height="20" HorizontalAlignment="Left" Width="160" Margin="0,10,0,0"/>

                    <!-- Create button -->
                    <Button Grid.Row="25" Grid.ColumnSpan="2" Content="Create Energuide File" Command="{Binding CreateEnerguideCommand}" Height="22" Margin="0,13,0,0"/>
                </Grid>
            </TabItem>


            <!-- ═══════════════════ Code Modeling TAB ═══════════════════ -->
            <TabItem Header="Code">
                <Grid x:Name="grid" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="102*"/>
                        <ColumnDefinition Width="39*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.8*"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Button Content="Select Template" Command="{Binding TemplateCommand}" HorizontalAlignment="Left" Margin="20,42,0,0" VerticalAlignment="Top" Width="190" Grid.Row="0" Height="20" TabIndex="2" Grid.ColumnSpan="3"/>
                    <CheckBox Content="Include Windows" Grid.Row="0" Margin="131,44,22,0" VerticalAlignment="Top" IsChecked="{Binding Source={x:Static properties:Settings.Default},Path=WindowsCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" TabIndex="3" Grid.Column="2"/>
                    <Button Content="Create Proposed File" Command="{Binding CreatePropCommand}" HorizontalAlignment="Left" Margin="20,99,0,0" VerticalAlignment="Top" Width="320" Height="20" Grid.Row="0" Grid.ColumnSpan="4" TabIndex="4"/>
                    <Button Content="Select Proposed File" Command="{Binding SelectPropFileCommand}" HorizontalAlignment="Left" Margin="0,237,0,0" VerticalAlignment="Top" Width="240" Height="20" TabIndex="5" Grid.ColumnSpan="2" Grid.Column="1" Grid.RowSpan="2"/>
                    <Button Content="Create REF" Command="{Binding CreateRefCommand}" HorizontalAlignment="Left" Width="320" Grid.Row="1" Height="20" VerticalAlignment="Top" Margin="20,46,0,0" Grid.ColumnSpan="4" TabIndex="6"/>
                    <TextBlock HorizontalAlignment="Left" Margin="20,45,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Text="{Binding ProposedFileLabel}" Grid.ColumnSpan="4"/>
                    <ComboBox HorizontalAlignment="Right" Margin="0,236,22,0" VerticalAlignment="Top" Width="75" Height="20" Grid.ColumnSpan="2"
                              ItemsSource="{Binding ZoneNames}" SelectedIndex="{Binding SelectedZoneIndex}" Grid.Column="2" Grid.RowSpan="2"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" Text="{Binding TemplateLabel}" Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="300" Margin="0,67,0,0" Grid.Column="1"/>
                    <GroupBox Header="PROPOSED" Margin="10,10,10,95" Grid.Row="0" BorderBrush="#FF979CA0" Panel.ZIndex="-1" Grid.ColumnSpan="4"/>
                    <GroupBox Header="REFERENCE" Margin="10,192,10,182" Panel.ZIndex="-1" BorderBrush="#FF979CA0" Grid.ColumnSpan="4" Grid.RowSpan="2">
                        <Label Content="Zone" HorizontalAlignment="Left" Margin="262,0,0,0" VerticalAlignment="Top" Width="75" Height="27"/>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
