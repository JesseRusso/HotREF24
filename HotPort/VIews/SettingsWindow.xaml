<Window x:Class="HotPort.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HotPort.Views"
        mc:Ignorable="d"
        Title="Settings" Height="330"  Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Height="22" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="75" Height="22" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Directories">
                <views:DirectoriesSettingsView DataContext="{Binding Directories}"/>
            </TabItem>
            <TabItem Header="Standard Doors">
                <views:WindowsDoorsSettingsView DataContext="{Binding Doors}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
